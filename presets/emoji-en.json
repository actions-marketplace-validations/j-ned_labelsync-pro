{
  "$schema": "https://raw.githubusercontent.com/j-ned/labelsync-pro/master/schema/labels.schema.json",
  "labels": [
    { "name": "🛠️ Chore", "description": "Maintenance or technical tasks", "color": "6c757d" },
    { "name": "✨ Feature", "description": "New feature or enhancement", "color": "198754", "aliases": ["enhancement"] },
    { "name": "🐛 Fix", "description": "Bug or error fix", "color": "dc3545", "aliases": ["bug"] },
    { "name": "🚑 Hotfix", "description": "Urgent production fix", "color": "b22222" },
    { "name": "♻️ Refactor", "description": "Code reorganization or optimization", "color": "6f42c1" },
    { "name": "🚀 Release", "description": "Stable version delivery", "color": "0d6efd" },
    { "name": "📦 Update", "description": "General updates or changes", "color": "ffc107" },
    { "name": "⚙️ CI/CD", "description": "Continuous integration and deployment changes", "color": "ffa500" },
    { "name": "📦 Dependencies", "description": "Dependency upgrades or removals", "color": "8b4513", "aliases": ["dependencies"] },
    { "name": "🏗️ Build", "description": "Changes affecting the build process", "color": "4a148c" },
    { "name": "📖 Docs", "description": "Documentation added or updated", "color": "17a2b8", "aliases": ["documentation"] },
    { "name": "⚡ Perf", "description": "Performance improvements", "color": "ff4500" },
    { "name": "🌀 Cache", "description": "Caching and state handling optimizations", "color": "2e8b57" },
    { "name": "🔐 Security", "description": "Security fix or hardening", "color": "ff0000" },
    { "name": "🔑 Auth", "description": "Authentication and session management changes", "color": "5f9ea0" },
    { "name": "✅ Validation", "description": "Data validation added or improved", "color": "2a9df4" },
    { "name": "🎨 Style", "description": "CSS or styling-only changes", "color": "ff69b4" },
    { "name": "🖌️ UI/UX", "description": "Visual or user experience improvements", "color": "ff1493" },
    { "name": "🎭 Animations", "description": "CSS/JS animations added or fixed", "color": "9932cc" },
    { "name": "♿ A11y", "description": "Web accessibility improvements", "color": "008000", "aliases": ["accessibility"] },
    { "name": "🌐 API", "description": "API endpoints or request changes", "color": "1e90ff" },
    { "name": "🗄️ Database", "description": "Database schema changes", "color": "4682b4" },
    { "name": "🧠 State Management", "description": "Store changes (NgRx, Redux, Signals)", "color": "6a5acd" },
    { "name": "🧪 Test", "description": "Unit or e2e tests added or changed", "color": "32cd32" },
    { "name": "🎭 Mock", "description": "Test mocks added", "color": "20b2aa" },
    { "name": "🔍 Debug", "description": "Debugging and minor non-critical fixes", "color": "ff8c00" },
    { "name": "🧹 Cleanup", "description": "Dead or unused code removed", "color": "808080" },
    { "name": "⏪ Revert", "description": "Reverts a previous change", "color": "b22222" },
    { "name": "🚚 Migration", "description": "Version migration or partial rewrite", "color": "ff4500" }
  ]
}
